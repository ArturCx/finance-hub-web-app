generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id            String                   @id @default(uuid())
  name          String
  type          TransactionType
  amount        Decimal                  @db.Decimal(10, 2)
  category      TransactionCategory
  paymentMethod TransactionPaymentMethod
  date          DateTime
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  userId        String

  @@map("transactions")
}

model Bills {
  id            String            @id @default(uuid())
  name          String
  status        BillStatus
  amount        Decimal           @db.Decimal(10, 2)
  category      BillCategory
  paymentMethod BillPaymentMethod
  expireDate    DateTime
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  userId        String

  @@map("bills")
}

model Cryptos {
  id                       String        @id @default(uuid())
  externalId               String        @unique
  name                     String
  image                    String
  currentPrice             Decimal
  marketCapRank            Decimal
  marketCap                Decimal
  priceChangePercentage24h Decimal
  totalVolume              Decimal
  charts                   CryptoCharts? @relation(name: "CryptoChartsToCryptos")

  @@map("cryptos")
}

model CryptoCharts {
  id           String   @id @default(uuid())
  externalId   String   @unique
  prices       Json
  marketCaps   Json
  totalVolumes Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  Cryptos      Cryptos? @relation(name: "CryptoChartsToCryptos", fields: [externalId], references: [externalId])

  @@map("crypto_charts")
}

enum TransactionType {
  DEPOSIT
  EXPENSE
  INVESTMENT
}

enum TransactionCategory {
  HOUSING
  TRANSPORTATION
  FOOD
  ENTERTAINMENT
  HEALTH
  UTILITY
  SALARY
  EDUCATION
  GROCERIES
  DINING
  SHOPPING
  PERSONAL_CARE
  PETS
  SUBSCRIPTIONS
  TELECOM
  INSURANCE
  TAXES
  DEBT
  TRAVEL
  FITNESS
  GIFTS
  KIDS
  FREELANCE
  INVESTMENT_INCOME
  REFUND
  SALES
  OTHER
}

enum TransactionPaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  BANK_SLIP
  CASH
  PIX
  OTHER
}

enum BillStatus {
  PAID
  PAYABLE
  EXPIRED
}

enum BillCategory {
  HOUSING
  TRANSPORTATION
  FOOD
  ENTERTAINMENT
  HEALTH
  UTILITY
  SALARY
  EDUCATION
  GROCERIES
  DINING
  SHOPPING
  PERSONAL_CARE
  PETS
  SUBSCRIPTIONS
  TELECOM
  INSURANCE
  TAXES
  DEBT
  TRAVEL
  FITNESS
  GIFTS
  KIDS
  FREELANCE
  INVESTMENT_INCOME
  REFUND
  SALES
  OTHER
}

enum BillPaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  BANK_SLIP
  CASH
  PIX
  OTHER
}

model CreditCard {
  id            String           @id @default(uuid())
  name          String
  color         String           @default("#0097b2")
  closingDay    Int
  dueDay        Int
  limit         Decimal?         @db.Decimal(10, 2)
  currentAmount Decimal          @default(0) @db.Decimal(10, 2)
  userId        String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  payments      InvoicePayment[]

  @@index([userId])
  @@map("credit_cards")
}

model InvoicePayment {
  id            String     @id @default(uuid())
  amount        Decimal    @db.Decimal(10, 2)
  paidAt        DateTime
  creditCardId  String
  creditCard    CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  transactionId String?
  userId        String
  createdAt     DateTime   @default(now())

  @@index([userId])
  @@map("invoice_payments")
}

model UserSettings {
  userId                   String   @id
  includeInvoicesInBalance Boolean  @default(false)
  investmentGoal           Decimal? @db.Decimal(12, 2)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("user_settings")
}
